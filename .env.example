# OpenAI API key – chỉ đặt trên máy chủ, không commit file .env
OPENAI_API_KEY=sk-your-secret-key-here
OPENAI_MODEL=gpt-5.5

# Mật khẩu Admin – hãy thay bằng mật khẩu dài, khó đoán
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Dùng đường dẫn volume lưu trữ bền vững do nền tảng hosting cấp
DATA_DIR=./data
PORT=3000
NODE_ENV=production
